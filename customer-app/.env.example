# API do cardápio (Laravel)
VITE_API_URL=http://localhost:8000/api

# Confirmação instantânea do Pix (mesmas chaves do Pusher no backend)
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=
VITE_PUSHER_SCHEME=https

# Intervalo do polling de pagamento (ms) — fallback se Pusher estiver off
VITE_PAYMENTS_POLLING_MS=700

# Google Places Autocomplete no checkout (https://aistudio.google.com/apikey)
# Ative: Places API (+ Maps JavaScript API se o Google exigir)
VITE_GOOGLE_MAPS_API_KEY=
