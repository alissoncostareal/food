APP_NAME=PartiuMenu
APP_ENV=local
# Obrigatório: php artisan key:generate --force
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
ASSET_URL=
APP_TIMEZONE=America/Fortaleza

# Mídia (logo, banner, produtos). Local: public | Produção Render: s3 (R2 ou AWS)
MEDIA_DISK=public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Docker Compose (serviço db = Postgres)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=food_db
DB_USERNAME=root
DB_PASSWORD=password

# Pagar.me da plataforma (assinaturas SaaS / planos — NÃO é o Pix da loja)
PAGARME_ENVIRONMENT=sandbox
PAGARME_PUBLIC_KEY=
PAGARME_SECRET_KEY=
PAGARME_ACCOUNT_ID=
# Secret do webhook em /api/v1/billing/pagarme/webhook (só planos)
PAGARME_WEBHOOK_USER=partiumenu
PAGARME_WEBHOOK_SECRET=
PAGARME_WEBHOOK_URL=
PAGARME_STATEMENT_DESCRIPTOR=PARTIUMENU

# iFood — produção
IFOOD_ENVIRONMENT=sandbox
IFOOD_DISTRIBUTED_CLIENT_ID=
IFOOD_DISTRIBUTED_CLIENT_SECRET=
IFOOD_WEBHOOK_SECRET=
IFOOD_WEBHOOK_URL=https://sua-api.com/api/v1/integrations/ifood/webhook

# iFood — sandbox (testes centralizados)
IFOOD_CENTRALIZED_CLIENT_ID=
IFOOD_CENTRALIZED_CLIENT_SECRET=

# iFood — opcionais
IFOOD_BASE_URL=https://merchant-api.ifood.com.br
IFOOD_PRESENCE_BY_MERCHANT=false
IFOOD_ORDER_CATEGORIES=FOOD
IFOOD_TIMEOUT=20

# Geocoding (autocomplete de endereço no cardápio)
# Mapbox: 100k buscas/mês grátis — https://account.mapbox.com/
GEOAPIFY_API_KEY=
MAPBOX_ACCESS_TOKEN=
GEOCODING_USER_AGENT="${APP_NAME} (${APP_URL})"

# Google Gemini (Inteligência + bot WhatsApp — https://aistudio.google.com/apikey)
WHATSAPP_AI_PROVIDER=gemini
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=20
INSIGHTS_CACHE_TTL=1800
GEMINI_MAX_OUTPUT_TOKENS=1200

# Evolution API (WhatsApp — planos Pro/Premium)
# Local: docker compose --profile evolution up -d  (+ serviço queue no compose)
# Produção (Render → serviço Laravel API): copie de backend/.env.production
# EVOLUTION_API_KEY = mesma chave do AUTHENTICATION_API_KEY do Evolution
EVOLUTION_ENABLED=false
EVOLUTION_API_URL=http://evolution_api:8080
EVOLUTION_API_KEY=change-me
EVOLUTION_INSTANCE_NAME=partiumenu-otp
EVOLUTION_WEBHOOK_URL=http://localhost:8000
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_TIMEOUT=20
EVOLUTION_PROVISION_TIMEOUT=90
WHATSAPP_TEST_MODE=false
WHATSAPP_AI_RATE_LIMIT_PER_HOUR=20

# WhatsApp oficial (Meta Cloud API) — lojas em Integrações → Oficial (Meta)
META_WHATSAPP_ENABLED=false
META_WHATSAPP_TEST_MODE=false
META_WHATSAPP_APP_ID=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_WHATSAPP_GRAPH_VERSION=v21.0

# Template de autenticação aprovado na Meta (OTP plataforma)
META_WHATSAPP_OTP_TEMPLATE_NAME=
META_WHATSAPP_OTP_TEMPLATE_LANGUAGE=pt_BR

# Login do cliente no cardápio (código WhatsApp). Desative até a Meta aprovar o template OTP.
CUSTOMER_OTP_LOGIN_ENABLED=true

QUEUE_CONNECTION=database

# Broadcasting (pedidos em tempo real)
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

FRONTEND_URL=http://localhost:5174
ADMIN_DASHBOARD_URL=http://localhost:5175
DEMO_STORE_SLUGS=lojademo
APP_MENU_URL=http://localhost:5174

# Login com Google (painel admin)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Local: MAIL_MAILER=log | Produção (Brevo): smtp-relay.brevo.com
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@partiumenu.com.br"
MAIL_FROM_NAME="${APP_NAME}"
# Brevo: SMTP & API → chave SMTP (não é a senha da conta). Remetente deve estar verificado no Brevo.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_USERNAME=ae94d0001@smtp-brevo.com  (login SMTP do Brevo)
# MAIL_PASSWORD=xsmtpsib-...

# Só o painel admin usa cookies Sanctum; o cardápio (5174) usa Bearer token.
SANCTUM_STATEFUL_DOMAINS=localhost:5175,127.0.0.1:5175

# Super admin (painel /super-admin) — rode: php artisan app:ensure-super-admin
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
