<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Arquivos e pastas reais continuam sendo servidos normalmente
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Rotas do Vue Router (ex.: /login, /register, /dashboard)
    RewriteRule ^ index.html [L]
</IfModule>
