{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "partiumenu-landingpage",
  "compatibility_date": "2026-06-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    // SPA fallback is handled here — do not ship public/_redirects (Wrangler loop).
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
