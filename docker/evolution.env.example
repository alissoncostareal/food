# Variáveis para `docker compose --profile evolution up -d` (raiz do projeto food)
# NÃO coloque isso no backend/.env — Laravel usa backend/.env com EVOLUTION_* diferente.

EVOLUTION_POSTGRES_PASSWORD=evolution123
EVOLUTION_API_KEY=9f8d2e4c1b7a6d3e5f9a8c2b4d6e1f7a3b5c9d2e4f6a8b1c
EVOLUTION_SERVER_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Repositório Evolution em prod (evolution-partiumenu.com.br) — .env DO SERVIDOR
# ---------------------------------------------------------------------------
# AUTHENTICATION_API_KEY=<mesma EVOLUTION_API_KEY do backend>
# SERVER_URL=https://evolution-partiumenu.com.br
# DATABASE_CONNECTION_URI=postgresql://...
# DATABASE_PROVIDER=postgresql
# REDIS_URI=redis://...

# ---------------------------------------------------------------------------
# Render (Web Service Evolution) — variáveis no painel Render
# ---------------------------------------------------------------------------
# O Render injeta PORT=10000. Se SERVER_PORT=8080, o deploy falha com:
#   "No open ports detected"
# Defina:
#   SERVER_PORT=10000
#   SERVER_URL=https://evolution.partiumenu.com.br
#   SERVER_TYPE=http
#   DATABASE_ENABLED=true
#   DATABASE_PROVIDER=postgresql
#   DATABASE_CONNECTION_URI=<Internal Database URL do Postgres Render>
#   AUTHENTICATION_API_KEY=<mesma EVOLUTION_API_KEY do backend>
#
# Não atualize Prisma 6→7 por causa do aviso no log — é só informativo.

# ---------------------------------------------------------------------------
# Render (backend Laravel) — backend/.env ou painel Render
# ---------------------------------------------------------------------------
# EVOLUTION_ENABLED=true
# EVOLUTION_API_URL=https://evolution.partiumenu.com.br
# EVOLUTION_API_KEY=<mesma AUTHENTICATION_API_KEY>
# EVOLUTION_WEBHOOK_URL=https://api.partiumenu.com.br
# EVOLUTION_INSTANCE_NAME=partiumenu-otp
# QUEUE_CONNECTION=sync
