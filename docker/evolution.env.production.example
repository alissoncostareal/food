# Cole no Render → partimentenu-evolution → Environment
# AUTHENTICATION_API_KEY = mesma EVOLUTION_API_KEY do backend Laravel
# Webhooks são configurados POR LOJA pelo backend (/webhook/set/{instance}) — não use WEBHOOK_GLOBAL

# --- Servidor (Render) ---
SERVER_TYPE=http
SERVER_PORT=10000
SERVER_URL=https://evolution.partiumenu.com.br
SERVER_NAME=partiumenu-evolution
LANGUAGE=pt_BR

# --- Auth (igual EVOLUTION_API_KEY no backend) ---
AUTHENTICATION_API_KEY=
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true

# --- Postgres (banco evolution_api, usuário evolution_user, URL INTERNAL) ---
# Sem aspas na URI. DATABASE_PROVIDER é obrigatório para o migrate no startup.
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution_user:SENHA@dpg-xxxxx-a/evolution_api?schema=public
DATABASE_CONNECTION_CLIENT_NAME=evolution_partiumenu
DATABASE_DELETE_MESSAGE=false

# Persistência mínima: só instância/conexão WhatsApp (bot salva histórico no Laravel)
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=false
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_DATA_HISTORIC=false
DATABASE_SAVE_IS_ON_WHATSAPP=false

# --- Cache (sem Redis no Render) ---
CACHE_LOCAL_ENABLED=true
CACHE_REDIS_ENABLED=false

# --- WhatsApp / QR ---
CONFIG_SESSION_PHONE_CLIENT=PartiuMenu
CONFIG_SESSION_PHONE_NAME=Chrome
QRCODE_LIMIT=30
DEL_INSTANCE=false

# --- Webhook global OFF (backend configura por loja) ---
WEBHOOK_GLOBAL_ENABLED=false
WEBHOOK_GLOBAL_URL=

# --- CORS / logs ---
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE
CORS_CREDENTIALS=true
LOG_LEVEL=ERROR,WARN,INFO
LOG_BAILEYS=error
LOG_COLOR=true

# --- Desligados (não usados no PartiuMenu) ---
CHATWOOT_ENABLED=false
RABBITMQ_ENABLED=false
KAFKA_ENABLED=false
SQS_ENABLED=false
PUSHER_ENABLED=false
WEBSOCKET_ENABLED=false
OPENAI_ENABLED=false
DIFY_ENABLED=false
TYPEBOT_ENABLED=false
N8N_ENABLED=false
S3_ENABLED=false
TELEMETRY_ENABLED=false
PROMETHEUS_METRICS=false

# --- Verificar após deploy (psql no evolution_api) ---
# SELECT COUNT(*) FROM "_prisma_migrations";   -- ~60 = migrations OK
# SELECT COUNT(*) FROM "Instance";               -- 0 até conectar lojas no admin
# Log esperado: "Migration succeeded" + "HTTP - ON: 10000"
# Imagem Docker: evoapicloud/evolution-api:v2.3.7 (não atendai/evolution-api)
